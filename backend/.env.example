# Prachar.ai - AWS Credentials Configuration
# Copy this file to .env and fill in your actual credentials

# AWS Credentials (Required)
# Get these from: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# AWS Region (Required)
# Recommended: us-east-1 or us-west-2 for Nova Lite availability
AWS_REGION=us-east-1

# AWS Session Token (Optional - only for temporary credentials)
# AWS_SESSION_TOKEN=your_session_token_here

# Bedrock Configuration (Optional)
# BEDROCK_KB_ID=your_knowledge_base_id
# GUARDRAIL_ID=your_guardrail_id
# GUARDRAIL_VERSION=DRAFT

# S3 Configuration (Optional)
# S3_BUCKET=prachar-ai-assets

# DynamoDB Configuration (Optional)
# DYNAMODB_TABLE=prachar-campaigns
# Agency Bridge table (clients + shared campaign threads). If unset the
# bridge defaults to "avoir-agency"; falls back to a local JSON file when
# the table or AWS credentials are unavailable.
# DYNAMODB_AGENCY_TABLE=avoir-agency

# Gemini API (Required for Daily Alpha Brief + Trend Sniper)
# Get keys from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_secondary_gemini_api_key_here

# SerpAPI (Required for Real-Time Google Trends)
# Get key from: https://serpapi.com -> Dashboard -> API Key
# Free tier: 100 searches/month
SERPAPI_KEY=your_serpapi_key_here

# YouTube Data API v3 (Optional — TrendSniper Tier 2 fallback)
# Get key from: https://console.cloud.google.com → APIs & Services → Enable "YouTube Data API v3"
YOUTUBE_API_KEY=your_youtube_api_key_here

# Upstash Redis (Required for Daily Alpha Brief cache)
# Get these from: https://console.upstash.com -> Your Database -> REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Admin token for forcing a Daily Alpha Brief regeneration
# The /api/alpha-brief?force=true endpoint rejects requests without this
# token sent as the X-Admin-Token header (used by the nightly cron Lambda).
# Leave empty to keep the force-refresh endpoint disabled (fail closed).
ALPHA_BRIEF_ADMIN_TOKEN=

# Apify (Optional — TikTok trend source for TrendSniper, Tier 3)
# Get token from: https://console.apify.com → Settings → Integrations
# Actor defaults to clockworks/tiktok-scraper; override with APIFY_TIKTOK_ACTOR
APIFY_API_TOKEN=
# APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
