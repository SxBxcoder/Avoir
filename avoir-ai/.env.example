# AWS Cognito Configuration
# Get these values from AWS Console after creating a Cognito User Pool
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-client-id-here

# AWS Bedrock (existing)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Ad Platform Webhooks (Performance Tracking)
# Meta (Facebook) Ads — get from Meta App Dashboard → Webhooks → Secret Key
META_ADS_WEBHOOK_SECRET=your-meta-webhook-secret
# Google Ads — get from Google Cloud Console → API & Services → Credentials
GOOGLE_ADS_WEBHOOK_SECRET=your-google-webhook-secret

# Shadow Clone Video Generation
# ElevenLabs — get from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# HeyGen — get from https://app.heygen.com/settings/api
HEYGEN_API_KEY=your-heygen-api-key
# HeyGen Avatar ID (optional — defaults to built-in avatar)
HEYGEN_AVATAR_ID=your-heygen-avatar-id
