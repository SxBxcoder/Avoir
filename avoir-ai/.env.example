# AWS Cognito Configuration
# Get these values from AWS Console after creating a Cognito User Pool
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-client-id-here

# AWS Bedrock (existing)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Real-Time Trend Intelligence (trends_sniper.py)
# SerpAPI — https://serpapi.com (free tier: 100 searches/mo)
SERPAPI_KEY=your-serpapi-key
# Reddit API — https://www.reddit.com/prefs/apps (create "script" app)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
# Python backend URL (default: http://localhost:8001)
TRENDS_BACKEND_URL=http://localhost:8001
# Cache TTL in hours (default: 48)
TREND_CACHE_TTL=48
